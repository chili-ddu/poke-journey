extends GutTest
const Fill=preload("res://scripts/ui/recovery_fill.gd")
func test_initial_values_and_changes_of_actor_capacity_or_skill_snap():
	var f=Fill.new()
	f.step(5,20,"a",0.0)
	assert_eq(f.value,5.0)
	f.step(15,20,"b",0.0)
	assert_eq(f.value,15.0)
	f.step(18,24,"b",0.0)
	assert_eq(f.value,18.0)
func test_recovery_is_bounded_smooth_and_finishes():
	var f=Fill.new()
	f.step(2,20,"a",0.0)
	f.step(12,20,"a",0.0)
	assert_eq(f.value,2.0)
	f.step(12,20,"a",0.11)
	assert_almost_eq(f.value,7.0,0.001)
	assert_eq(f.target,12.0)
	f.step(12,20,"a",0.11)
	assert_eq(f.value,12.0)
	assert_eq(f.ratio(),0.6)
func test_damage_or_spending_interrupts_recovery_immediately():
	var f=Fill.new()
	f.step(2,20,"a",0.0)
	f.step(20,20,"a",0.1)
	f.step(4,20,"a",0.0)
	assert_eq(f.value,4.0)
	assert_eq(f.target,4.0)
	f.step(0,20,"a",0.0)
	assert_eq(f.ratio(),0.0)
func test_repeated_recovery_retargets_from_current_display_without_going_backwards():
	var f=Fill.new()
	f.step(0,30,"pp",0.0)
	f.step(10,30,"pp",0.1)
	var before: float=f.value
	f.step(20,30,"pp",0.0)
	assert_eq(f.value,before)
	f.step(20,30,"pp",1.0)
	assert_eq(f.value,20.0)
func test_empty_slot_and_out_of_range_values_are_safe():
	var f=Fill.new()
	f.step(10,0,"empty",0.0)
	assert_eq(f.value,0.0)
	assert_eq(f.ratio(),0.0)
	f.step(99,20,"move",0.0)
	assert_eq(f.value,20.0)
